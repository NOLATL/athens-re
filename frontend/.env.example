# Copy this file to .env.local for local overrides (Vite auto-loads it, gitignored)
# In CI/CD, set VITE_API_URL as a GitHub Actions secret — Vite bakes it into the bundle.

# Your Azure App Service backend URL (no trailing slash)
# Leave blank to default to http://localhost:5000 in development
VITE_API_URL=https://your-app-name.azurewebsites.net
