# Athens RE Investment Platform — environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.
#
# For Azure App Service: set these as Application Settings in the portal
# (Configuration → Application settings), not as a .env file.

# ── API keys ──────────────────────────────────────────────────────────────────
# Census Bureau API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Rentometer API key ($30/mo): https://www.rentometer.com/api
RENTOMETER_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to SQLite (local dev). For Azure SQL, set a full connection string:
# DATABASE_URL=mssql+pyodbc://user:pass@server.database.windows.net/db?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///backend/db/real_estate.db

# ── Email / nightly digest ────────────────────────────────────────────────────
# Choose provider: "smtp" (Gmail app password) or "sendgrid"
EMAIL_PROVIDER=smtp

# Gmail SMTP — generate an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# SendGrid — get a free API key at https://sendgrid.com (100 emails/day free)
SENDGRID_API_KEY=

# Digest recipient and sender
NOTIFY_EMAIL=your@email.com
FROM_EMAIL=noreply@athens-re.app

# Optional: public URL of the deployed app (included as a link in the email digest)
APP_URL=https://your-app.azurewebsites.net
